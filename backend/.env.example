# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore) — see the security audit for why that matters.

# Postgres connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/command_center

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# "development" enables /docs, /redoc, /openapi.json. Any other value
# (including leaving this unset) locks the app down as production.
ENVIRONMENT=development

# Comma-separated list of frontend origins allowed to call this API.
# In production, set this to your real deployed frontend URL(s), e.g.
# ALLOWED_ORIGINS=https://nomi-navy-one.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional: drives the dashboard's dismissible announcement banner. Both
# unset means no banner. Bump ANNOUNCEMENT_ID whenever you change the
# message — that's what makes it show up again for someone who already
# dismissed a previous one.
# ANNOUNCEMENT_ID=cat-exams-2026
# ANNOUNCEMENT_MESSAGE=CAT Exams begin in 2 days — check your hall tickets on VTOP.
