# Copy this file to .env and fill in real values if you want the local
# dev server to talk to something other than localhost:8000. Never commit
# .env itself (it's already in .gitignore).

# Base URL of the FastAPI backend. Leave unset for local dev — api.js
# already falls back to http://localhost:8000 on its own. Vercel sets this
# directly in its own dashboard (Settings > Environment Variables), not
# from this file — Vite bakes it into the build at build time.
# VITE_API_URL=https://nomi-oesp.onrender.com
